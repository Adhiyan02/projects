package com.example.securepasswordmanager

import android.content.Intent
import android.os.Bundle
import android.widget.*
import androidx.appcompat.app.AppCompatActivity
import androidx.cardview.widget.CardView

class DashboardActivity : AppCompatActivity() {

    private lateinit var db: DatabaseHelper

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_dashboard)

        db = DatabaseHelper(this)

        findViewById<CardView>(R.id.addPasswordCard).setOnClickListener {
            startActivity(Intent(this, AddPasswordActivity::class.java))
        }
        findViewById<CardView>(R.id.viewPasswordsCard).setOnClickListener {
            startActivity(Intent(this, ViewPasswordsActivity::class.java))
        }
        findViewById<CardView>(R.id.secureNotesCard).setOnClickListener {
            startActivity(Intent(this, SecureNotesActivity::class.java))
        }
        findViewById<CardView>(R.id.settingsCard).setOnClickListener {
            Toast.makeText(this, getString(R.string.settings_coming_soon), Toast.LENGTH_SHORT).show()
        }
    }

    private fun updateDashboard() {
        val total   = db.getTotalPasswords()
        val weak    = db.getWeakPasswords()
        val reused  = db.getReusedPasswords()
        val strong  = total - weak

        findViewById<TextView>(R.id.totalPasswordsText).text  = total.toString()
        findViewById<TextView>(R.id.strongPasswordsText).text = strong.toString()
        findViewById<TextView>(R.id.weakPasswordsText).text   = weak.toString()
        findViewById<TextView>(R.id.reusedPasswordsText).text = reused.toString()

        val score = if (total == 0) 100 else {
            val wPct = weak.toFloat()   / total * 100
            val rPct = reused.toFloat() / total * 100
            maxOf(0, 100 - (wPct * 0.6 + rPct * 0.4).toInt())
        }

        findViewById<TextView>(R.id.securityScoreText).text = "$score%"
        findViewById<ProgressBar>(R.id.securityScoreBar).progress = score

        val color = when {
            score >= 80 -> getColor(android.R.color.holo_green_dark)
            score >= 60 -> getColor(android.R.color.holo_orange_light)
            else        -> getColor(android.R.color.holo_red_light)
        }
        findViewById<TextView>(R.id.securityScoreText).setTextColor(color)

        val statusText = when {
            score >= 80 -> "Excellent Security! 🛡️"
            score >= 60 -> "Good Security 👍"
            score >= 40 -> "Needs Improvement ⚠️"
            else        -> "Poor Security ❌"
        }
        findViewById<TextView>(R.id.securityStatusText).text = statusText

        // Category breakdown
        val layout = findViewById<LinearLayout>(R.id.categoryBreakdownLayout)
        layout.removeAllViews()
        val categories = arrayOf("Personal","Work","Finance","Social","Email","Shopping","Other")
        categories.forEach { cat ->
            val count = db.getPasswordsByCategory(cat).size
            if (count > 0) {
                val tv = TextView(this).apply {
                    text = "$cat  ›  $count password${if (count == 1) "" else "s"}"
                    textSize = 15f
                    setPadding(0, 6, 0, 6)
                }
                layout.addView(tv)
            }
        }
        if (layout.childCount == 0) {
            val tv = TextView(this).apply {
                text = "No passwords saved yet."
                textSize = 15f
                setTextColor(getColor(android.R.color.darker_gray))
            }
            layout.addView(tv)
        }
    }

    override fun onResume() {
        super.onResume()
        updateDashboard()
    }
}
