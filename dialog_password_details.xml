package com.example.securepasswordmanager

import android.os.Bundle
import android.view.LayoutInflater
import android.view.View
import android.view.ViewGroup
import android.widget.*
import androidx.appcompat.app.AlertDialog
import androidx.appcompat.app.AppCompatActivity
import androidx.cardview.widget.CardView
import androidx.recyclerview.widget.LinearLayoutManager
import androidx.recyclerview.widget.RecyclerView
import com.google.android.material.floatingactionbutton.FloatingActionButton

class SecureNotesActivity : AppCompatActivity() {

    private lateinit var db: DatabaseHelper
    private lateinit var recyclerView: RecyclerView
    private lateinit var adapter: NotesAdapter
    private var notesList = ArrayList<HashMap<String, String>>()

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_secure_notes)

        db = DatabaseHelper(this)
        recyclerView = findViewById(R.id.notesRecyclerView)
        val addNoteBtn = findViewById<FloatingActionButton>(R.id.addNoteBtn)

        recyclerView.layoutManager = LinearLayoutManager(this)
        loadNotes()

        addNoteBtn.setOnClickListener {
            showAddNoteDialog()
        }
    }

    private fun loadNotes() {
        notesList = db.getAllNotes()
        adapter = NotesAdapter(notesList)
        recyclerView.adapter = adapter
    }

    private fun showAddNoteDialog() {
        val dialogView = layoutInflater.inflate(R.layout.dialog_add_note, null)
        
        val titleInput = dialogView.findViewById<EditText>(R.id.noteTitleInput)
        val contentInput = dialogView.findViewById<EditText>(R.id.noteContentInput)
        val categorySpinner = dialogView.findViewById<Spinner>(R.id.noteCategorySpinner)
        
        val categories = arrayOf("General", "Personal", "Work", "Ideas", "Important", "Other")
        val adapter = ArrayAdapter(this, android.R.layout.simple_spinner_item, categories)
        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
        categorySpinner.adapter = adapter
        
        AlertDialog.Builder(this)
            .setTitle("New Secure Note")
            .setView(dialogView)
            .setPositiveButton("Save") { _, _ ->
                val title = titleInput.text.toString()
                val content = contentInput.text.toString()
                val category = categorySpinner.selectedItem.toString()
                
                if (title.isNotEmpty() && content.isNotEmpty()) {
                    db.insertNote(title, content, category)
                    Toast.makeText(this, "Note saved", Toast.LENGTH_SHORT).show()
                    loadNotes()
                } else {
                    Toast.makeText(this, "Please fill all fields", Toast.LENGTH_SHORT).show()
                }
            }
            .setNegativeButton("Cancel", null)
            .show()
    }

    inner class NotesAdapter(private val list: ArrayList<HashMap<String, String>>) :
        RecyclerView.Adapter<NotesAdapter.ViewHolder>() {

        inner class ViewHolder(view: View) : RecyclerView.ViewHolder(view) {
            val card: CardView = view.findViewById(R.id.noteCard)
            val titleText: TextView = view.findViewById(R.id.noteTitleText)
            val categoryText: TextView = view.findViewById(R.id.noteCategoryText)
            val deleteBtn: ImageButton = view.findViewById(R.id.deleteNoteBtn)
        }

        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): ViewHolder {
            val view = LayoutInflater.from(parent.context)
                .inflate(R.layout.item_note, parent, false)
            return ViewHolder(view)
        }

        override fun onBindViewHolder(holder: ViewHolder, position: Int) {
            val item = list[position]
            
            holder.titleText.text = item["title"]
            holder.categoryText.text = item["category"] ?: "General"

            holder.card.setOnClickListener {
                showNoteDetails(item)
            }

            holder.deleteBtn.setOnClickListener {
                AlertDialog.Builder(this@SecureNotesActivity)
                    .setTitle("Delete Note")
                    .setMessage("Are you sure you want to delete this note?")
                    .setPositiveButton("Delete") { _, _ ->
                        db.deleteNote(item["id"]!!)
                        Toast.makeText(this@SecureNotesActivity, "Note deleted", Toast.LENGTH_SHORT).show()
                        loadNotes()
                    }
                    .setNegativeButton("Cancel", null)
                    .show()
            }
        }

        override fun getItemCount() = list.size
    }

    private fun showNoteDetails(item: HashMap<String, String>) {
        val dialogView = layoutInflater.inflate(R.layout.dialog_note_details, null)
        
        dialogView.findViewById<TextView>(R.id.noteDetailTitle).text = item["title"]
        dialogView.findViewById<TextView>(R.id.noteDetailCategory).text = item["category"] ?: "General"
        
        try {
            val decryptedContent = db.decrypt(item["content"] ?: "")
            dialogView.findViewById<TextView>(R.id.noteDetailContent).text = decryptedContent
        } catch (e: Exception) {
            dialogView.findViewById<TextView>(R.id.noteDetailContent).text = "Error decrypting note"
        }
        
        AlertDialog.Builder(this)
            .setTitle("Note Details")
            .setView(dialogView)
            .setPositiveButton("Close", null)
            .show()
    }

    override fun onResume() {
        super.onResume()
        loadNotes()
    }
}
