<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Website" android:textSize="12sp" android:textColor="#888"/>
        <TextView android:id="@+id/detailSite" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"
            android:textColor="#212121" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Username" android:textSize="12sp" android:textColor="#888"/>
        <TextView android:id="@+id/detailUser" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textColor="#212121" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Category" android:textSize="12sp" android:textColor="#888"/>
        <TextView android:id="@+id/detailCategory" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="#6200EE" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Notes" android:textSize="12sp" android:textColor="#888"/>
        <TextView android:id="@+id/detailNotes" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="#555" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Password" android:textSize="12sp" android:textColor="#888"/>
        <TextView android:id="@+id/detailPassword" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="••••••••••••"
            android:textSize="18sp" android:fontFamily="monospace"
            android:textColor="#6200EE" android:background="#F3E5FF"
            android:padding="10dp" android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/showPasswordBtn"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Show Password" android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/copyPlainPasswordBtn"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="📋 Copy Password" android:textAllCaps="false"
            android:backgroundTint="#6200EE" android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>
