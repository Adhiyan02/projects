package com.example.securepasswordmanager

import android.content.ClipData
import android.content.ClipboardManager
import android.content.Context
import android.content.Intent
import android.os.Bundle
import android.text.Editable
import android.text.TextWatcher
import android.view.LayoutInflater
import android.view.View
import android.view.ViewGroup
import android.widget.*
import androidx.appcompat.app.AlertDialog
import androidx.appcompat.app.AppCompatActivity
import androidx.cardview.widget.CardView
import androidx.recyclerview.widget.LinearLayoutManager
import androidx.recyclerview.widget.RecyclerView

class ViewPasswordsActivity : AppCompatActivity() {

    private lateinit var db: DatabaseHelper
    private lateinit var recyclerView: RecyclerView
    private lateinit var adapter: PasswordAdapter
    private var passwordList = ArrayList<HashMap<String, String>>()

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_view_passwords)

        db = DatabaseHelper(this)
        recyclerView = findViewById(R.id.passwordRecyclerView)
        val searchBar = findViewById<EditText>(R.id.searchBar)
        val categoryFilter = findViewById<Spinner>(R.id.categoryFilter)

        recyclerView.layoutManager = LinearLayoutManager(this)
        loadPasswords()

        // Setup category filter
        val categories = arrayOf("All Categories", "Personal", "Work", "Finance", "Social", "Email", "Shopping", "Other")
        val spinnerAdapter = ArrayAdapter(this, android.R.layout.simple_spinner_item, categories)
        spinnerAdapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
        categoryFilter.adapter = spinnerAdapter

        categoryFilter.onItemSelectedListener = object : AdapterView.OnItemSelectedListener {
            override fun onItemSelected(parent: AdapterView<*>?, view: View?, position: Int, id: Long) {
                val selected = categories[position]
                if (selected == "All Categories") {
                    loadPasswords()
                } else {
                    passwordList = db.getPasswordsByCategory(selected)
                    adapter = PasswordAdapter(passwordList)
                    recyclerView.adapter = adapter
                }
            }
            override fun onNothingSelected(parent: AdapterView<*>?) {}
        }

        // Search functionality
        searchBar.addTextChangedListener(object : TextWatcher {
            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
                val query = s.toString()
                if (query.isEmpty()) {
                    loadPasswords()
                } else {
                    passwordList = db.searchPasswords(query)
                    adapter = PasswordAdapter(passwordList)
                    recyclerView.adapter = adapter
                }
            }
            override fun afterTextChanged(s: Editable?) {}
        })
    }

    private fun loadPasswords() {
        passwordList = db.getAllPasswords()
        adapter = PasswordAdapter(passwordList)
        recyclerView.adapter = adapter
    }

    inner class PasswordAdapter(private val list: ArrayList<HashMap<String, String>>) :
        RecyclerView.Adapter<PasswordAdapter.ViewHolder>() {

        inner class ViewHolder(view: View) : RecyclerView.ViewHolder(view) {
            val card: CardView = view.findViewById(R.id.passwordCard)
            val siteIcon: TextView = view.findViewById(R.id.siteIconText)
            val siteText: TextView = view.findViewById(R.id.siteText)
            val userText: TextView = view.findViewById(R.id.userText)
            val categoryText: TextView = view.findViewById(R.id.categoryText)
            val favoriteIcon: ImageView = view.findViewById(R.id.favoriteIcon)
            val copyBtn: ImageButton = view.findViewById(R.id.copyBtn)
            val editBtn: ImageButton = view.findViewById(R.id.editBtn)
            val deleteBtn: ImageButton = view.findViewById(R.id.deleteBtn)
        }

        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): ViewHolder {
            val view = LayoutInflater.from(parent.context)
                .inflate(R.layout.item_password, parent, false)
            return ViewHolder(view)
        }

        override fun onBindViewHolder(holder: ViewHolder, position: Int) {
            val item = list[position]
            
            holder.siteText.text = item["site"]
            holder.userText.text = item["user"]
            holder.categoryText.text = item["category"] ?: "Personal"
            
            // Set icon based on category
            val emoji = when (item["category"]) {
                "Work" -> "💼"
                "Finance" -> "💰"
                "Social" -> "👥"
                "Email" -> "📧"
                "Shopping" -> "🛒"
                else -> "🔑"
            }
            holder.siteIcon.text = emoji

            // Favorite state
            val isFavorite = item["is_favorite"] == "1"
            holder.favoriteIcon.setImageResource(
                if (isFavorite) android.R.drawable.star_big_on 
                else android.R.drawable.star_big_off
            )

            holder.favoriteIcon.setOnClickListener {
                db.toggleFavorite(item["id"]!!)
                loadPasswords()
            }

            // Click to view details
            holder.card.setOnClickListener {
                showPasswordDetails(item)
            }

            // Copy password
            holder.copyBtn.setOnClickListener {
                try {
                    val decrypted = db.decrypt(item["pass"] ?: "")
                    val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
                    val clip = ClipData.newPlainText("password", decrypted)
                    clipboard.setPrimaryClip(clip)
                    Toast.makeText(this@ViewPasswordsActivity, "Password copied!", Toast.LENGTH_SHORT).show()
                } catch (e: Exception) {
                    Toast.makeText(this@ViewPasswordsActivity, "Error copying password", Toast.LENGTH_SHORT).show()
                }
            }

            // Edit
            holder.editBtn.setOnClickListener {
                val intent = Intent(this@ViewPasswordsActivity, AddPasswordActivity::class.java)
                intent.putExtra("EDIT_MODE", true)
                intent.putExtra("ID", item["id"])
                intent.putExtra("SITE", item["site"])
                intent.putExtra("USER", item["user"])
                intent.putExtra("PASS", item["pass"])
                intent.putExtra("CATEGORY", item["category"])
                intent.putExtra("NOTES", item["notes"])
                startActivity(intent)
            }

            // Delete
            holder.deleteBtn.setOnClickListener {
                AlertDialog.Builder(this@ViewPasswordsActivity)
                    .setTitle("Delete Password")
                    .setMessage("Are you sure you want to delete this password?")
                    .setPositiveButton("Delete") { _, _ ->
                        db.deletePassword(item["id"]!!)
                        Toast.makeText(this@ViewPasswordsActivity, "Deleted", Toast.LENGTH_SHORT).show()
                        loadPasswords()
                    }
                    .setNegativeButton("Cancel", null)
                    .show()
            }
        }

        override fun getItemCount() = list.size
    }

    private fun showPasswordDetails(item: HashMap<String, String>) {
        val dialogView = layoutInflater.inflate(R.layout.dialog_password_details, null)
        
        dialogView.findViewById<TextView>(R.id.detailSite).text = item["site"]
        dialogView.findViewById<TextView>(R.id.detailUser).text = item["user"]
        dialogView.findViewById<TextView>(R.id.detailCategory).text = item["category"] ?: "Personal"
        dialogView.findViewById<TextView>(R.id.detailNotes).text = item["notes"] ?: "No notes"
        
        val passwordText = dialogView.findViewById<TextView>(R.id.detailPassword)
        val showBtn = dialogView.findViewById<Button>(R.id.showPasswordBtn)
        val copyBtn = dialogView.findViewById<Button>(R.id.copyPlainPasswordBtn)
        
        var passwordShown = false
        
        showBtn.setOnClickListener {
            passwordShown = !passwordShown
            if (passwordShown) {
                try {
                    passwordText.text = db.decrypt(item["pass"] ?: "")
                    showBtn.text = "Hide Password"
                } catch (e: Exception) {
                    passwordText.text = "Error decrypting"
                }
            } else {
                passwordText.text = "••••••••••••"
                showBtn.text = "Show Password"
            }
        }
        
        copyBtn.setOnClickListener {
            try {
                val decrypted = db.decrypt(item["pass"] ?: "")
                val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
                val clip = ClipData.newPlainText("password", decrypted)
                clipboard.setPrimaryClip(clip)
                Toast.makeText(this, "Password copied!", Toast.LENGTH_SHORT).show()
            } catch (e: Exception) {
                Toast.makeText(this, "Error copying password", Toast.LENGTH_SHORT).show()
            }
        }
        
        AlertDialog.Builder(this)
            .setTitle("Password Details")
            .setView(dialogView)
            .setPositiveButton("Close", null)
            .show()
    }

    override fun onResume() {
        super.onResume()
        loadPasswords()
    }
}
