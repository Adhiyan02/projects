package com.example.securepasswordmanager

import android.content.Intent
import android.os.Bundle
import android.view.View
import android.widget.*
import androidx.appcompat.app.AppCompatActivity

class AddPasswordActivity : AppCompatActivity() {

    lateinit var db: DatabaseHelper
    private var editMode = false
    private var editId = ""

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_add_password)

        db = DatabaseHelper(this)

        val site = findViewById<EditText>(R.id.siteInput)
        val user = findViewById<EditText>(R.id.userInput)
        val pass = findViewById<EditText>(R.id.passInput)
        val notesInput = findViewById<EditText>(R.id.notesInput)
        val categorySpinner = findViewById<Spinner>(R.id.categorySpinner)
        val saveBtn = findViewById<Button>(R.id.saveBtn)
        val viewBtn = findViewById<Button>(R.id.viewBtn)
        val decryptBtn = findViewById<Button>(R.id.decryptScreenBtn)
        val generateBtn = findViewById<Button>(R.id.generateBtn)
        val dashboardBtn = findViewById<Button>(R.id.dashboardBtn)
        val notesBtn = findViewById<Button>(R.id.notesBtn)
        val strengthText = findViewById<TextView>(R.id.strengthText)
        val strengthBar = findViewById<ProgressBar>(R.id.strengthBar)
        val passwordLengthText = findViewById<TextView>(R.id.passwordLengthText)
        val togglePasswordBtn = findViewById<ImageButton>(R.id.togglePasswordBtn)

        // Setup category spinner
        val categories = arrayOf("Personal", "Work", "Finance", "Social", "Email", "Shopping", "Other")
        val adapter = ArrayAdapter(this, android.R.layout.simple_spinner_item, categories)
        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
        categorySpinner.adapter = adapter

        // Check if in edit mode
        editMode = intent.getBooleanExtra("EDIT_MODE", false)
        if (editMode) {
            editId = intent.getStringExtra("ID") ?: ""
            site.setText(intent.getStringExtra("SITE"))
            user.setText(intent.getStringExtra("USER"))
            
            // Decrypt and show password for editing
            val encryptedPass = intent.getStringExtra("PASS") ?: ""
            try {
                pass.setText(db.decrypt(encryptedPass))
            } catch (e: Exception) {
                pass.setText("")
            }
            
            notesInput.setText(intent.getStringExtra("NOTES"))
            val category = intent.getStringExtra("CATEGORY") ?: "Personal"
            categorySpinner.setSelection(categories.indexOf(category))
            
            saveBtn.text = "Update Password"
            findViewById<TextView>(R.id.titleText).text = "Edit Password"
        }

        // Toggle password visibility
        var passwordVisible = false
        togglePasswordBtn.setOnClickListener {
            passwordVisible = !passwordVisible
            if (passwordVisible) {
                pass.inputType = android.text.InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD
                togglePasswordBtn.setImageResource(android.R.drawable.ic_menu_view)
            } else {
                pass.inputType = android.text.InputType.TYPE_CLASS_TEXT or android.text.InputType.TYPE_TEXT_VARIATION_PASSWORD
                togglePasswordBtn.setImageResource(android.R.drawable.ic_menu_view)
            }
            pass.setSelection(pass.text.length)
        }

        // SAVE/UPDATE
        saveBtn.setOnClickListener {
            val siteText = site.text.toString()
            val userText = user.text.toString()
            val passText = pass.text.toString()
            val notesText = notesInput.text.toString()
            val category = categorySpinner.selectedItem.toString()

            if (siteText.isEmpty() || userText.isEmpty() || passText.isEmpty()) {
                Toast.makeText(this, "Please fill all required fields", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }

            if (editMode) {
                db.updatePassword(editId, siteText, userText, passText, category, notesText)
                Toast.makeText(this, "Password Updated", Toast.LENGTH_SHORT).show()
            } else {
                db.insertData(siteText, userText, passText, category, notesText)
                Toast.makeText(this, "Password Saved", Toast.LENGTH_SHORT).show()
            }

            // Clear fields after save (only in add mode)
            if (!editMode) {
                site.setText("")
                user.setText("")
                pass.setText("")
                notesInput.setText("")
                categorySpinner.setSelection(0)
            } else {
                finish() // Go back if in edit mode
            }
        }

        // VIEW
        viewBtn.setOnClickListener {
            startActivity(Intent(this, ViewPasswordsActivity::class.java))
        }

        // DECRYPT SCREEN
        decryptBtn.setOnClickListener {
            startActivity(Intent(this, DecryptPasswordActivity::class.java))
        }

        // DASHBOARD
        dashboardBtn.setOnClickListener {
            startActivity(Intent(this, DashboardActivity::class.java))
        }

        // SECURE NOTES
        notesBtn.setOnClickListener {
            startActivity(Intent(this, SecureNotesActivity::class.java))
        }

        // GENERATE PASSWORD
        generateBtn.setOnClickListener {
            showPasswordGeneratorDialog(pass)
        }

        // STRENGTH CHECK
        pass.addTextChangedListener(object : android.text.TextWatcher {
            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
                val password = s.toString()
                val strength = checkStrength(password)
                strengthText.text = "Strength: ${strength.first}"
                strengthText.setTextColor(strength.third)
                strengthBar.progress = strength.second
                passwordLengthText.text = "${password.length} characters"
            }
            override fun afterTextChanged(s: android.text.Editable?) {}
        })
    }

    private fun showPasswordGeneratorDialog(passField: EditText) {
        val dialog = android.app.AlertDialog.Builder(this)
        val dialogView = layoutInflater.inflate(R.layout.dialog_password_generator, null)
        
        val lengthSeekBar = dialogView.findViewById<SeekBar>(R.id.lengthSeekBar)
        val lengthText = dialogView.findViewById<TextView>(R.id.lengthText)
        val uppercaseCheck = dialogView.findViewById<CheckBox>(R.id.uppercaseCheck)
        val lowercaseCheck = dialogView.findViewById<CheckBox>(R.id.lowercaseCheck)
        val numbersCheck = dialogView.findViewById<CheckBox>(R.id.numbersCheck)
        val symbolsCheck = dialogView.findViewById<CheckBox>(R.id.symbolsCheck)
        val generatedPassText = dialogView.findViewById<TextView>(R.id.generatedPasswordText)
        val generateAgainBtn = dialogView.findViewById<Button>(R.id.generateAgainBtn)
        
        lengthSeekBar.progress = 12
        lengthText.text = "Length: 12"
        uppercaseCheck.isChecked = true
        lowercaseCheck.isChecked = true
        numbersCheck.isChecked = true
        symbolsCheck.isChecked = true
        
        lengthSeekBar.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(seekBar: SeekBar?, progress: Int, fromUser: Boolean) {
                lengthText.text = "Length: $progress"
            }
            override fun onStartTrackingTouch(seekBar: SeekBar?) {}
            override fun onStopTrackingTouch(seekBar: SeekBar?) {}
        })
        
        fun generateCustomPassword(): String {
            val length = lengthSeekBar.progress
            var chars = ""
            if (uppercaseCheck.isChecked) chars += "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
            if (lowercaseCheck.isChecked) chars += "abcdefghijklmnopqrstuvwxyz"
            if (numbersCheck.isChecked) chars += "0123456789"
            if (symbolsCheck.isChecked) chars += "!@#$%^&*()_+-=[]{}|;:,.<>?"
            
            if (chars.isEmpty()) chars = "abcdefghijklmnopqrstuvwxyz0123456789"
            
            return (1..length).map { chars.random() }.joinToString("")
        }
        
        val initialPassword = generateCustomPassword()
        generatedPassText.text = initialPassword
        
        generateAgainBtn.setOnClickListener {
            generatedPassText.text = generateCustomPassword()
        }
        
        dialog.setView(dialogView)
        dialog.setPositiveButton("Use This Password") { _, _ ->
            passField.setText(generatedPassText.text.toString())
        }
        dialog.setNegativeButton("Cancel", null)
        dialog.show()
    }

    private fun generatePassword(): String {
        val chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*"
        return (1..16).map { chars.random() }.joinToString("")
    }

    private fun checkStrength(p: String): Triple<String, Int, Int> {
        if (p.isEmpty()) return Triple("None", 0, getColor(android.R.color.darker_gray))
        if (p.length < 6) return Triple("Weak", 25, getColor(android.R.color.holo_red_dark))
        
        val hasUpper = p.matches(Regex(".*[A-Z].*"))
        val hasLower = p.matches(Regex(".*[a-z].*"))
        val hasDigit = p.matches(Regex(".*[0-9].*"))
        val hasSpecial = p.matches(Regex(".*[!@#\$%^&*()_+\\-=\\[\\]{}|;:,.<>?].*"))
        
        val score = listOf(hasUpper, hasLower, hasDigit, hasSpecial).count { it }
        
        return when {
            p.length >= 12 && score >= 3 -> Triple("Very Strong", 100, getColor(android.R.color.holo_green_dark))
            p.length >= 10 && score >= 3 -> Triple("Strong", 75, getColor(android.R.color.holo_green_light))
            p.length >= 8 && score >= 2 -> Triple("Medium", 50, getColor(android.R.color.holo_orange_light))
            else -> Triple("Weak", 25, getColor(android.R.color.holo_red_light))
        }
    }
}
